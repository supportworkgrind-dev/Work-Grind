{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/socket-io.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health/redis",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/socket-io(?:/.*)?",
      "dest": "/api/socket-io.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/social-publishing/dispatch",
      "schedule": "0 0 * * *"
    }
  ]
}
