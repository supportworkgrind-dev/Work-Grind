# Local development or self-hosted worker settings.
# LiveKit Cloud injects the three LIVEKIT_* values into deployed agents.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# HTTPS origin of the WorkGrind backend API (origin only, no /api suffix).
# The worker calls /api/ai/voice/turn; configure Tavro AI credentials on backend.
WORKGRIND_BACKEND_URL=https://your-workgrind-backend.example.com
