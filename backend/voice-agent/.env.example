# Obtain the WebSocket URL and API credentials from your LiveKit project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# HTTPS origin of the WorkGrind backend. The worker calls its authenticated
# voice-turn endpoint; configure Tavro's AI provider only on the backend.
WORKGRIND_BACKEND_URL=https://your-workgrind-backend.example.com
