{
  "name": "workgrind-backend",
  "version": "1.0.0",
  "description": "WorkGrind Backend API",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:mem": "cross-env NODE_OPTIONS=--max-old-space-size=1024 ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test:auth-refresh": "npm run build && node --test tests/*.test.cjs",
    "start": "node dist/index.js",
    "calling-id:backfill": "node dist/scripts/backfillCallingIds.js",
    "make-super-admin": "node dist/scripts/makeSuperAdmin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@google/genai": "^2.22.0",
    "@livekit/protocol": "^1.52.1",
    "@polar-sh/sdk": "^0.49.0",
    "@socket.io/mongo-adapter": "^0.4.0",
    "agents": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.14",
    "livekit-server-sdk": "^2.19.1",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "openai": "^7.23.0",
    "otplib": "12.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
