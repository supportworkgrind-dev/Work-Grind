# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Full MongoDB Atlas SRV connection string.
# Get from: Atlas → Cluster → Connect → Drivers → Copy connection string
# Replace <user> and <password> with your Atlas database user credentials.
# The /workgrind at the end sets the default database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/workgrind?appName=WorkGrind&retryWrites=true&w=majority

# ── Optional shared Redis cache / rate-limit store ────────────────────────────
# Analytics cache falls back to MongoDB when Redis is missing or unavailable.
# Rate limits fall back to express-rate-limit's process-local store. In serverless
# environments, limits are not coordinated across separate function instances.
# Create a Redis database in Upstash and use its REST URL and REST token.
# The REST URL must use HTTPS; do not use a redis:// or rediss:// TCP URL here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── JWT Authentication ────────────────────────────────────────────────────────
# Use separate, independently generated 64-byte random values in production.
# Generate each with: node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
# Do not reuse either value for client-portal or MFA encryption.
# IMPORTANT: Changing these values invalidates ALL active user sessions.
JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Client Portal JWT ─────────────────────────────────────────────────────────
# Separate secret for external client sessions. Must differ from JWT_SECRET.
# Falls back to JWT_SECRET+"_client" if unset — set explicitly in production.
CLIENT_JWT_SECRET=change_me_client_portal_secret_min_32_chars

# ── Frontend ──────────────────────────────────────────────────────────────────
# Exact origin for generated links and the default browser CORS origin.
# Set the backend Vercel project's Root Directory to backend so backend/vercel.json
# routes requests to the serverless entry point. Configure production values in
# Vercel Project Settings; local development reads backend/.env.
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Additional comma-separated exact origins for browser CORS and Socket.IO.
CORS_ORIGINS=

# ── Google / Apple Sign-In (optional) ─────────────────────────────────────────
# Production callback URLs must use the BACKEND_URL origin and reach the backend
# callback route. Local development can use the frontend API proxy origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production callback uses the backend origin. Local development can use the
# frontend proxy callback at localhost:3000.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
# LinkedIn OpenID Connect (optional). Configure the same callback URI in the
# LinkedIn developer application and LINKEDIN_CALLBACK_URL. Production must
# use BACKEND_URL's HTTPS origin and /api/auth/oauth/linkedin/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://your-public-backend-host/api/auth/oauth/linkedin/callback
# Update when LinkedIn retires a monthly Marketing API version.
LINKEDIN_API_VERSION=202609
# Apple Service ID and Sign in with Apple key details (server-side only).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Keep the .p8 key private; encode line breaks as \n in this environment value.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://your-public-backend-host/api/auth/oauth/apple/callback

# ── Cloudflare Realtime TURN ──────────────────────────────────────────────────
# Keep the TURN API token server-side. The authenticated RTC endpoint exchanges
# it for short-lived ICE credentials; never add these values to frontend env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── Email (SMTP / Gmail) ──────────────────────────────────────────────────────
# Required for real email delivery. No test mailbox or fake JSON fallback is used.
# For Gmail: use a 16-character App Password (not your account password).
# Generate at: https://myaccount.google.com/apppasswords
# Port 587 uses STARTTLS; port 465 uses implicit TLS. Production uses HTTPS CLIENT_URL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.workgrind@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_USER=support.workgrind@gmail.com
EMAIL_PASS=your_gmail_app_password_here
# Legacy EMAIL_USER/EMAIL_PASS aliases remain supported; prefer SMTP_USER/SMTP_PASS.
FROM_EMAIL=support.workgrind@gmail.com
FROM_NAME=WorkGrind
SUPPORT_EMAIL=support.workgrind@gmail.com

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
# Backend-only — NEVER use NEXT_PUBLIC_ for this variable.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=45000

# ── Tavro Voice (LiveKit) ────────────────────────────────────────────────────
# Use the WebSocket URL from your LiveKit project. Keep API credentials server-side.
# The deployed worker also needs these variables plus GEMINI_API_KEY/GEMINI_MODEL.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Tavro AI fallback: Cloudflare Workers AI ──────────────────────────────────
# Server-side only. The API token must have Workers AI access.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b

# ── File Uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# Create credentials at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# R2_ACCOUNT_ID: found at Cloudflare Dashboard → right sidebar
# R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY: from the API token you create
# R2_BUCKET_NAME: the name of your bucket in R2 (not changed after creation)
# R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ── Polar Payments ────────────────────────────────────────────────────────────
# Get your token at: https://polar.sh → Organisation → Settings → API
# Backend-only — NEVER expose POLAR_ACCESS_TOKEN in frontend code.
POLAR_ACCESS_TOKEN=polar_at_your_token_here
# Use 'sandbox' for testing, 'production' for live payments
POLAR_ENVIRONMENT=sandbox
# Webhook secret — generated in Polar Dashboard → Webhooks → Create Endpoint
POLAR_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Product IDs — copy from Polar Dashboard → Products (after creating products)
# Create a 'WorkGrind Starter' recurring product ($9/mo) → copy its ID below
POLAR_STARTER_PRODUCT_ID=your_polar_starter_product_id
# Create a 'WorkGrind Pro' recurring product ($19/mo) → copy its ID below
POLAR_PRO_PRODUCT_ID=your_polar_pro_product_id

# ── MFA Encryption ────────────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt TOTP secrets before storing in MongoDB.
# Must be exactly 32 characters in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
# Falls back to JWT_SECRET if unset (weaker — always set this explicitly).
MFA_ENCRYPTION_KEY=change_me_mfa_key_exactly_32_chars_here
